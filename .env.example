# Copy to .env and fill in. Tests and evals run fully offline with MOCK_MODE=true.
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter (has free models),
# Ollama (http://localhost:11434/v1, no key needed), opencode Zen, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter example:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL=nvidia/nemotron-3.5-lightning:free
MODEL=gpt-4o-mini
MOCK_MODE=true
MAX_STEPS=12
MAX_INPUT_CHARS=4000
DB_PATH=data/support.db
KB_PATH=data/kb.json
LOG_LEVEL=INFO
EVAL_PASS_THRESHOLD=0.8
